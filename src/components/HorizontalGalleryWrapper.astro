---
import HorizontalGallery from '@/components/HorizontalGallery';

const images = [
  { 
    src: "/familia_sun_monasterio.webp?height=200&width=300", 
    alt: "Familia Sun Monasterio", 
    title: "Familia Sun en el Monasterio", 
    description: "Representantes del linaje tradicional reuniéndose en el patio del monasterio budista para celebrar y conmemorar la herencia del estilo Sun." 
  },
  { 
    src: "/familia_sun_1.jpeg?height=200&width=300", 
    alt: "La Gran Familia Sun", 
    title: "La Gran Familia Sun", 
    description: "Gran Maestro Sun Zhendai (4ª generación) junto a su familia, transmitiendo y preservando las tradiciones familiares y el arte del Taiji." 
  },
  { 
    src: "/sifu_con_familia_sun.jpeg?height=200&width=300", 
    alt: "Sifu Jorge con la Familia Sun", 
    title: "Sifu Jorge con la Familia Sun", 
    description: "El Maestro Jorge Quiñones (6ª generación de Dingxing) compartiendo y alineándose con los portadores del linaje de la familia Sun en China." 
  },
  { 
    src: "/familia_sun_3.jpeg?height=200&width=300", 
    alt: "Reunión de Maestros", 
    title: "Reunión de Maestros del Linaje", 
    description: "Encuentro oficial de la familia Sun, consolidando la transmisión pedagógica e histórica del Taiji Quan tradicional." 
  },
  { 
    src: "/familia_sun_templo_1.webp?height=200&width=300", 
    alt: "Templo de entrenamiento", 
    title: "Portadores de la Tradición en el Templo", 
    description: "Reunión de maestros del estilo Sun y discípulos del linaje de Dingxing frente al templo principal de entrenamiento." 
  },
  { 
    src: "/practica_con_maestro.jpeg?height=200&width=300", 
    alt: "Práctica Tui Shou", 
    title: "Práctica con el Maestro Wang Delong", 
    description: "El Maestro Jorge Quiñones perfeccionando técnicas de empuje de manos (Tui Shou) bajo la supervisión directa de su maestro Wang Delong (5ª generación)." 
  },
  { 
    src: "/sifu_abat_monasterio.jpeg?height=200&width=300", 
    alt: "Sifu Jorge y el Abad", 
    title: "Sifu Jorge con el Abad del Monasterio", 
    description: "Encuentro de hermandad e intercambio filosófico entre el Maestro Jorge Quiñones y el Abad del templo durante sus viajes de formación." 
  },
  { 
    src: "/sifu_familia_uruguay.jpeg?height=200&width=300", 
    alt: "Sifu Jorge en Uruguay", 
    title: "Seminario de la Escuela en Uruguay", 
    description: "El Maestro Jorge Quiñones dirigiendo una sesión de formación y compartiendo la rica herencia del Taiji con los estudiantes de la filial de Uruguay." 
  },
  { 
    src: "/sifu_familia_sun.jpeg?height=200&width=300", 
    alt: "Sede central de la Asociación", 
    title: "Sifu Jorge junto a Maestros de Dingxing", 
    description: "Fotografía conmemorativa en la sede central de la Asociación de Artes Marciales de Sun Lutang en Dingxing, Hebei." 
  },
  { 
    src: "/sifu_con_maestro.jpeg?height=200&width=300", 
    alt: "Entrenamiento en China", 
    title: "Entrenamiento de Técnicas Internas", 
    description: "El Maestro Wang Delong corrigiendo detalles de postura y estructura corporal a su discípulo Jorge Quiñones en China." 
  },
  { 
    src: "/sifu_monasterio_1.jpeg?height=200&width=300", 
    alt: "Viaje de Formación", 
    title: "Viaje de Formación al Monasterio", 
    description: "El Maestro Jorge Quiñones en los históricos recintos de entrenamiento y templos sagrados, absorbiendo los principios clásicos taoístas." 
  },
  { 
    src: "/sifu_con_maestro_1.jpeg?height=200&width=300", 
    alt: "Transmisión del Legado", 
    title: "Transmisión del Legado", 
    description: "El Maestro Wang Delong compartiendo escritos clásicos y la teoría del boxeo de Sun Lutang con Sifu Jorge Quiñones." 
  }
];
---

<div class="mb-6 mt-6">
  <h2 class="text-3xl sm:text-5xl md:text-7xl font-bold mb-6">Galería Imagenes</h2>
  <HorizontalGallery client:load images={images} />
</div>

<style>
  h2 {
    text-align: center;
    margin-bottom: 1rem;
  }
</style>
