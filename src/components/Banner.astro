---
// Carousel.astro
---

<style>
  /* Estilos generales */
  .carousel-container {
    position: relative;
    overflow: hidden;
    width: 100%;
    margin: 0 auto;
  }

  .carousel-track {
    display: flex;
    width: 100%;
    transition: transform 0.5s ease-in-out;
  }

  .carousel-slide {
    flex: 0 0 100%;
    min-width: 100%;
    box-sizing: border-box;
  }

  .carousel-slide img {
    width: 100%;
    min-height: 200px;
    max-height: 600px;
    height: auto;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Botones de navegación */
  .carousel-button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    padding: 10px 14px;
    cursor: pointer;
    z-index: 10;
    border-radius: 4px;
    transition: background-color 0.3s ease;
  }

  .carousel-button:hover {
    background-color: rgba(0, 0, 0, 0.75);
  }

  .carousel-button.prev {
    left: 10px;
  }

  .carousel-button.next {
    right: 10px;
  }
</style>

<div class="carousel-container">
  <div class="carousel-track" id="carouselTrack">
    <!-- Clon de la última imagen (decorativo, para efecto loop) -->
    <div class="carousel-slide">
      <img src="/images/banner-web-4.png" alt="" />
    </div>

    <!-- Imágenes originales -->
    <div class="carousel-slide">
      <img
        src="/images/banner-web-1.png"
        alt="Shifu Jorge Quiñones frente al templo de la Escuela Sun Lutang en Dingxing, China"
      />
    </div>
    <div class="carousel-slide">
      <img
        src="/images/banner-web-2.png"
        alt="Shifu Jorge Quiñones junto a los maestros de la Asociación de Sun Lu Tang de Dingxing, China"
      />
    </div>
    <div class="carousel-slide">
      <img
        src="/images/banner-web-3.png"
        alt="Shifu Jorge Quiñones ejecutando una forma de Sun Tai Chi frente al templo de Dingxing"
      />
    </div>
    <div class="carousel-slide">
      <img
        src="/images/banner-web-4.png"
        alt="Shifu Jorge Quiñones en postura inicial de Sun Tai Chi en el templo de Dingxing, China"
      />
    </div>

    <!-- Clon de la primera imagen (decorativo, para efecto loop) -->
    <div class="carousel-slide">
      <img src="/images/banner-web-1.png" alt="" />
    </div>
  </div>

  <!-- Botones de navegación -->
  <button class="carousel-button prev" id="prevButton" aria-label="Imagen anterior">&#10094;</button>
  <button class="carousel-button next" id="nextButton" aria-label="Siguiente imagen">&#10095;</button>
</div>

<script>
  // JavaScript para el carrusel infinito
  const track = document.getElementById("carouselTrack");

  if (track) {
    const slides = Array.from(track.children);
    let currentIndex = 1; // Comenzamos en la primera imagen original (después del clon inicial)
    let isTransitioning = false;
    let autoPlayInterval: ReturnType<typeof setInterval>;

    function updateCarousel(withTransition = true) {
      if (!track) return;
      track.style.transition = withTransition
        ? "transform 0.5s ease-in-out"
        : "none";
      // Cada slide ocupa el 100% del contenedor (.carousel-track), por lo que desplazamos -currentIndex * 100%
      track.style.transform = `translateX(${-currentIndex * 100}%)`;
    }

    function moveToNextSlide() {
      if (isTransitioning) return;
      isTransitioning = true;
      currentIndex++;
      updateCarousel(true);
    }

    function moveToPrevSlide() {
      if (isTransitioning) return;
      isTransitioning = true;
      currentIndex--;
      updateCarousel(true);
    }

    // Al finalizar la transición, si estamos en un clon saltamos sin transición a la imagen original correspondiente
    track.addEventListener("transitionend", () => {
      isTransitioning = false;
      if (currentIndex >= slides.length - 1) {
        currentIndex = 1;
        updateCarousel(false);
      } else if (currentIndex <= 0) {
        currentIndex = slides.length - 2;
        updateCarousel(false);
      }
    });

    function resetAutoPlay() {
      clearInterval(autoPlayInterval);
      autoPlayInterval = setInterval(moveToNextSlide, 5000);
    }

    // Configuración inicial: posicionar el carrusel sin transición en la primera imagen
    updateCarousel(false);

    // Agregar eventos a los botones
    const prevButton = document.getElementById("prevButton");
    const nextButton = document.getElementById("nextButton");
    if (prevButton && nextButton) {
      nextButton.addEventListener("click", () => {
        moveToNextSlide();
        resetAutoPlay();
      });
      prevButton.addEventListener("click", () => {
        moveToPrevSlide();
        resetAutoPlay();
      });
    }

    // Movimiento automático infinito
    resetAutoPlay();
  }
</script>
