// Función para aplanar la estructura de datos del linaje
const flattenLineage = (arr) => {
  let result = [];
  arr.forEach(person => {
    result.push(person);
    if (person.children && person.children.length > 0) {
      result = result.concat(flattenLineage(person.children));
    }
  });
  return result;
};

// Obtener todas las personas en una lista plana
const allPeople = flattenLineage(lineageDataNested);

// Crear una lista de personas únicas para la galería
const uniquePeopleNames = new Set();
const uniquePeopleForGallery = allPeople.filter(person => {
  if (uniquePeopleNames.has(person.name)) {
    return false;
  }
  uniquePeopleNames.add(person.name);
  return true;
});

// Datos para el acordeón (puede ser el mismo lineageDataNested o uno procesado si es necesario)
// Por ahora, asumimos que el acordeón usará la estructura anidada directamente.
const lineage = lineageDataNested; // O lineageDataNested si el acordeón lo usa así.

