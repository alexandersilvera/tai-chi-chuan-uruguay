---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';

const lineage = [
  {
    name: "Sūn Lù Táng",
    title: "Zǔshī: Patriarca",
    info: "Sūn Lù Táng, también conocido como el Patriarca, fue un destacado MAESTRO de artes marciales chinas. Fue el fundador del estilo Sun de Tai Chi Chuan.",
    image: "/images/foto_linaje_5.webp",
    link: "/maestros/sun-lutang"
  },
  {
    name: "Sūn Zhèn Dài",
    title: "Zōngshī: Tatarabuelo Gran Maestro",
    info: "Sūn Zhèn Dài fue UN GRAN MAESTRO. Contribuyó significativamente a la transmisión del estilo Sun.",
    image: "/images/foto_linaje_4.webp",
    link: "/maestros/sun-zhendai"
  },
  {
    name: "Sūn Yŭ Rén",
    title: "Shī tàigōng: Bisabuelo",
    info: "Sūn Yŭ Rén fue un importante MAESTRO respetado en el linaje. Su sabiduría y disciplina inspiraron a generaciones futuras.",
    image: "/images/foto_linaje_3.webp",
    link: "/maestros/sun-yuren"
  },
  {
    name: "Sūn Yù Kuí",
    title: "Shīgōng: Abuelo",
    info: "Sūn Yù Kuí fue un MAESTRO clave en la transmisión del linaje. Mantuvo viva la tradición familiar del Tai Chi Chuan.",
    image: "/images/foto_linaje_2.webp",
    link: "/maestros/sun-yukui"
  },
  {
    name: "Wáng Dé Lóng",
    title: "Shīfù: Maestro Padre",
    info: "Wáng Dé Lóng es un MAESTRO dedicado. Su enseñanza ha influido en muchos estudiantes.",
    image: "/images/foto_linaje_1.webp",
    link: "/maestros/wang-delong"
  },
  {
    name: "Qin Feng - Jorge Quiñones",
    title: "Dìzǐ: Discípulo",
    info: "Qin Feng, también conocido como Jorge Quiñones, Es el Representante de la Asociacion de Artes Marciales De Sun Lu Tang de Dingxing en Uruguay, 6ª generación de la familia Sun de Ding Xing. Discipulo del Maestro Wang Delong.",
    image: "/images/shifu_jorge.webp",
    link: "/maestros/qin-feng"
  }
];
---

<Layout title="Linaje | Sun Taiji Quan Uruguay">
  <PageHeader
    title="Nuestro Linaje"
    description="Explora la rica herencia y el linaje de nuestra escuela Tai Ji Quan, desde los fundadores hasta los maestros actuales."
  />

  <section class="py-12 bg-slate-900">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative">
        <!-- La línea vertical de la timeline -->
        <div class="absolute left-1/2 -translate-x-1/2 h-full w-0.5 bg-slate-700 hidden md:block"></div>

        {lineage.map((master, index) => (
          <div class={`mb-12 flex justify-center md:justify-normal items-center w-full ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
            <div class="w-full md:w-5/12">
              <div class="bg-slate-800 rounded-lg shadow-lg overflow-hidden transition-transform duration-300 hover:scale-105 hover:shadow-celeste-500/20">
                <div class="aspect-w-16 aspect-h-9">
                    <img src={master.image} alt={`Foto de ${master.name}`} class="w-full h-full object-cover object-center" />
                </div>
                <div class="p-6">
                  <h3 class="text-2xl font-bold text-slate-200 mb-2">{master.name}</h3>
                  <p class="text-lg font-semibold text-green-500 mb-3">{master.title}</p>
                  <p class="text-slate-400 mb-4 text-sm">{master.info}</p>
                  <a href={master.link} class="inline-block bg-celeste-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-celeste-700 transition-colors">
                    Ver más información
                  </a>
                </div>
              </div>
            </div>
            
            <!-- El punto en la timeline -->
            <div class="hidden md:flex items-center justify-center w-2/12">
              <div class="w-4 h-4 bg-green-500 rounded-full shadow-md z-10"></div>
            </div>

            <!-- Espacio en blanco en el lado opuesto en desktop -->
            <div class="hidden md:block w-5/12"></div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>