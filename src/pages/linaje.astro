<style>
  #gallery-track {
    animation: scroll 40s linear infinite;
  }
  
  #gallery-container:hover #gallery-track {
    animation-play-state: paused;
  }

  #gallery-track > div {
    flex-shrink: 0;
  }

  @keyframes scroll {
    0% { 
      transform: translateX(0); 
    }
    100% { 
      transform: translateX(calc(-300px * 6 - 24px * 6)); 
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordionButtons = document.querySelectorAll('.accordion-button');
    const galleryImageWrappers = document.querySelectorAll('.gallery-image-wrapper');
    const galleryTrack = document.getElementById('gallery-track');

    // Configurar carrusel infinito
    if (galleryTrack) {
      const cards = galleryTrack.children;
      const cardWidth = 300; // 288px (w-72) + 24px (mx-3 * 2)
      const totalWidth = cardWidth * (cards.length / 2); // Solo contamos las originales
      
      // Función para resetear la posición sin animación
      function resetPosition() {
        galleryTrack.style.animation = 'none';
        galleryTrack.style.transform = 'translateX(0)';
        // Forzar reflow
        galleryTrack.offsetHeight;
        // Restaurar animación
        galleryTrack.style.animation = `scroll 40s linear infinite`;
      }

      // Escuchar el final de la animación
      galleryTrack.addEventListener('animationiteration', resetPosition);
    }

    function closeAllAccordionItems(exceptIndex = -1) {
      accordionButtons.forEach((button, index) => {
        if (index === exceptIndex) return;
        const content = button.parentElement?.nextElementSibling as HTMLElement;
        if (content) {
          button.classList.remove('active');
          button.setAttribute('aria-expanded', 'false');
          content.style.maxHeight = '';
          content.classList.add('hidden');
        }
        // Actualizar estado de imagen de galería si está conectada
        const galleryButton = document.querySelector(`.gallery-image-wrapper[data-accordion-target='${index}']`);
        if (galleryButton) {
            galleryButton.classList.remove('active');
        }
      });
    }

    accordionButtons.forEach((button, index) => {
      button.addEventListener('click', () => {
        const content = button.parentElement?.nextElementSibling as HTMLElement;
        if (!content) return;
        
        const isCurrentlyActive = button.classList.contains('active');

        closeAllAccordionItems(isCurrentlyActive ? -1 : index);

        if (!isCurrentlyActive) {
          button.classList.add('active');
          button.setAttribute('aria-expanded', 'true');
          content.classList.remove('hidden');
          content.style.maxHeight = content.scrollHeight + "px";
          // Activar imagen de galería correspondiente
          const galleryButton = document.querySelector(`.gallery-image-wrapper[data-accordion-target='${index}']`);
          if (galleryButton) {
            galleryButton.classList.add('active');
          }
        }
      });
    });

    galleryImageWrappers.forEach(wrapper => {
        wrapper.addEventListener('click', () => {
            const targetIndex = parseInt((wrapper as HTMLElement).dataset.accordionTarget || '0');
            const targetAccordionButton = document.querySelector(`.accordion-button[data-accordion-index='${targetIndex}']`) as HTMLElement;
            if (targetAccordionButton) {
                const isCurrentlyActive = targetAccordionButton.classList.contains('active');
                
                if (!isCurrentlyActive) {
                    targetAccordionButton.click();
                } else {
                    targetAccordionButton.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            }
        });
    });
  });
</script>