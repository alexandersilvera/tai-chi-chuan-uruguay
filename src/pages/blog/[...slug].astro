---
import BlogPost from "@/layouts/BlogPost.astro";
import { adminDB } from '@/lib/firebase/admin.js';
import { marked } from 'marked';

export const prerender = false;

const { slug } = Astro.params;

// Normalizar el slug a minúsculas para que coincida con Firestore
const normalizedSlug = slug.toLowerCase();

// Obtener el artículo de Firestore
const articleRef = adminDB.collection('articles').doc(normalizedSlug);
const articleDoc = await articleRef.get();

if (!articleDoc.exists) {
    return Astro.redirect("/404");
}

const data = articleDoc.data();

// Obtener el conteo de likes desde la colección 'likes'
let likesCount = 0;
try {
    const likesDoc = await adminDB.collection('likes').doc(normalizedSlug).get();
    if (likesDoc.exists) {
        likesCount = likesDoc.data().count || 0;
    }
} catch (error) {
    console.error(`Error getting likes for ${normalizedSlug}:`, error);
}

// Convertir el contenido Markdown a HTML
const contentHTML = marked(data.content || '');

const post = {
    data: {
        title: data.title || 'Sin título',
        description: data.description || '',
        pubDate: data.pubDate ? new Date(data.pubDate) : new Date(),
        heroImage: data.heroImage || '/images/banner-web-1.png',
        tags: Array.isArray(data.tags) ? data.tags : [],
        author: data.author || 'Admin',
        initialLikes: likesCount,
    },
    slug: normalizedSlug
};
---

<BlogPost {...post.data} slug={post.slug} initialLikes={post.data.initialLikes}>
    <Fragment set:html={contentHTML} />
</BlogPost>
