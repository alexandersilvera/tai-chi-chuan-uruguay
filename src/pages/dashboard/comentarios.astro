---
// Asegura que esta página se renderice en el servidor
export const prerender = false;

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import CommentsManager from '@/components/dashboard/CommentsManager.jsx';
import { adminDB } from '@/lib/firebase/admin.js';

// Tipos para TypeScript
interface CommentData {
  id: string;
  text: string;
  author: {
    id: string;
    name: string;
    email: string;
    avatar: string;
  };
  article: {
    id: string;
    title: string;
    slug: string;
  };
  timestamp: string;
  status: 'approved' | 'pending' | 'flagged';
  flags: number;
  likes: number;
}

let commentsData: CommentData[] = [];
let error: string | null = null;

try {
  if (!adminDB) {
    throw new Error("La conexión con la base de datos (adminDB) no está disponible. Revisa la configuración de Firebase Admin y las variables de entorno.");
  }

  console.log('🔄 Cargando comentarios desde Firebase...');

  // Obtener todos los comentarios usando collectionGroup (sin orderBy para evitar índices)
  const commentsSnapshot = await adminDB.collectionGroup('comments')
    .limit(200) // Limitamos a 200 comentarios
    .get();

  console.log(`✅ Comentarios obtenidos: ${commentsSnapshot.size}`);

  // Obtener usuarios (no hay posts principales, así que no podemos mapear artículos)
  const usersSnapshot = await adminDB.collection('users').get();

  // Crear mapa de usuarios para búsqueda rápida
  const usersMap = new Map();
  usersSnapshot.docs.forEach(doc => {
    usersMap.set(doc.id, doc.data());
  });

  // Procesar comentarios y ordenarlos por timestamp
  let rawComments = commentsSnapshot.docs.map(commentDoc => {
    const commentData = commentDoc.data();
    const userId = commentData.userId;
    const path = commentDoc.ref.path;
    
    // Extraer postId del path: posts/{postId}/comments/{commentId}
    const pathParts = path.split('/');
    const articleId = pathParts[1] || 'post-desconocido';

    // Obtener datos del usuario
    const userData = usersMap.get(userId);
    const userName = userData?.displayName || userData?.email?.split('@')[0] || 'Usuario Desconocido';
    const userEmail = userData?.email || 'email@desconocido.com';
    const userAvatar = userData?.photoURL || '/default-avatar.svg';

    // Como no hay posts principales, usar el postId como título
    const articleTitle = `Post: ${articleId}`;
    const articleSlug = articleId;

    return {
      id: commentDoc.id,
      text: commentData.text || 'Sin texto',
      author: {
        id: userId || 'unknown',
        name: userName,
        email: userEmail,
        avatar: userAvatar
      },
      article: {
        id: articleId || 'unknown',
        title: articleTitle,
        slug: articleSlug
      },
      timestamp: commentData.timestamp?.toDate ? commentData.timestamp.toDate().toISOString() : new Date().toISOString(),
      status: commentData.status || 'pending', // Por defecto pending si no hay status
      flags: commentData.flags || 0,
      likes: commentData.likes || 0,
      timestampDate: commentData.timestamp?.toDate?.() || new Date()
    };
  });
  
  // Ordenar comentarios por timestamp descendente (más recientes primero)
  commentsData = rawComments.sort((a, b) => {
    return b.timestampDate.getTime() - a.timestampDate.getTime();
  }).map(comment => {
    // Remover timestampDate del resultado final
    const { timestampDate, ...finalComment } = comment;
    return finalComment as CommentData;
  });

  console.log(`✅ Comentarios procesados: ${commentsData.length}`);
  console.log(`📊 Estados: Aprobados: ${commentsData.filter(c => c.status === 'approved').length}, Pendientes: ${commentsData.filter(c => c.status === 'pending').length}, Marcados: ${commentsData.filter(c => c.status === 'flagged').length}`);

} catch (err: unknown) {
  console.error("❌ Error obteniendo comentarios desde Firebase:", err);
  error = (err as Error).message || "Ocurrió un error al cargar los comentarios.";
}
---

<DashboardLayout title="Gestión de Comentarios - Panel de Administración">
  <div class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Gestión de Comentarios</h1>
      <p class="text-gray-600">Modera y gestiona todos los comentarios del sitio. Puedes aprobar, marcar o eliminar comentarios según sea necesario.</p>
      
      {error && (
        <div class="mt-4 bg-red-100 border-l-4 border-red-500 text-red-700 p-4" role="alert">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm">
                <strong>Error:</strong> {error}
              </p>
            </div>
          </div>
        </div>
      )}
      
      {!error && commentsData.length > 0 && (
        <div class="mt-4 bg-blue-50 border-l-4 border-blue-400 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-blue-700">
                <strong>Comentarios cargados:</strong> {commentsData.length} comentario{commentsData.length !== 1 ? 's' : ''} encontrado{commentsData.length !== 1 ? 's' : ''}
              </p>
              <p class="text-sm text-blue-600 mt-1">
                <strong>Estados:</strong> {commentsData.filter(c => c.status === 'approved').length} aprobados, 
                {commentsData.filter(c => c.status === 'pending').length} pendientes, 
                {commentsData.filter(c => c.status === 'flagged').length} marcados
              </p>
            </div>
          </div>
        </div>
      )}
    </div>

    {!error && (
      <CommentsManager comments={commentsData} client:load />
    )}
  </div>
</DashboardLayout>
