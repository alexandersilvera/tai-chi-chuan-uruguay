---
// Asegura que esta página se renderice en el servidor
export const prerender = false;

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import LikesManager from '@/components/dashboard/LikesManager.jsx';
import { adminDB } from '@/lib/firebase/admin.js';

// Tipos para TypeScript
interface LikeData {
  id: string;
  user: {
    id: string;
    name: string;
    email: string | null;
    avatar: string;
  };
  article: {
    id: string;
    title: string;
    slug: string;
  };
  timestamp: string;
  isAnonymous: boolean;
}

interface LikeStats {
  totalLikes: number;
  totalUsers: number;
  totalArticles: number;
  topArticles: Array<{ id: string; title: string; count: number }>;
  topUsers: Array<{ id: string; name: string; count: number }>;
}

let likesData: LikeData[] = [];
let likesStats: LikeStats = {
  totalLikes: 0,
  totalUsers: 0,
  totalArticles: 0,
  topArticles: [],
  topUsers: []
};
let error: string | null = null;

try {
  if (!adminDB) {
    throw new Error("La conexión con la base de datos (adminDB) no está disponible. Revisa la configuración de Firebase Admin y las variables de entorno.");
  }

  console.log('🔄 Cargando likes desde Firebase...');

  // Obtener todos los likes usando collectionGroup (sin orderBy para evitar índices)
  const likesSnapshot = await adminDB.collectionGroup('likes')
    .limit(500) // Limitamos a 500 likes
    .get();

  console.log(`✅ Likes obtenidos: ${likesSnapshot.size}`);

  // Obtener usuarios (no hay posts principales)
  const usersSnapshot = await adminDB.collection('users').get();

  // Crear mapa de usuarios para búsqueda rápida
  const usersMap = new Map();
  usersSnapshot.docs.forEach(doc => {
    usersMap.set(doc.id, doc.data());
  });

  // Contadores para estadísticas
  const articleCounts = new Map();
  const userCounts = new Map();
  const uniqueUsers = new Set();
  const uniqueArticles = new Set();

  // Procesar likes y ordenar por timestamp
  let rawLikes = likesSnapshot.docs.map(likeDoc => {
    const likeData = likeDoc.data();
    const userId = likeDoc.id; // En esta estructura, el ID del documento es el userId
    const path = likeDoc.ref.path;
    
    // Extraer postId del path: posts/{postId}/likes/{userId}
    const pathParts = path.split('/');
    const articleId = pathParts[1] || 'post-desconocido';

    // Obtener datos del usuario
    const userData = usersMap.get(userId);
    const userName = userData?.displayName || userData?.email?.split('@')[0] || 'Usuario Anónimo';
    const userEmail = userData?.email || null;
    const userAvatar = userData?.photoURL || '/default-avatar.svg';
    const isAnonymous = userId === 'anonymous' || !userData || !userEmail;

    // Como no hay posts principales, usar el postId como título
    const articleTitle = `Post: ${articleId}`;
    const articleSlug = articleId;

    // Contar para estadísticas
    uniqueArticles.add(articleId);
    if (!isAnonymous) {
      uniqueUsers.add(userId);
      userCounts.set(userId, (userCounts.get(userId) || 0) + 1);
    }
    articleCounts.set(articleId, (articleCounts.get(articleId) || 0) + 1);

    return {
      id: likeDoc.id,
      user: {
        id: userId || 'anonymous',
        name: userName,
        email: userEmail,
        avatar: userAvatar
      },
      article: {
        id: articleId || 'unknown',
        title: articleTitle,
        slug: articleSlug
      },
      timestamp: likeData.timestamp?.toDate ? likeData.timestamp.toDate().toISOString() : new Date().toISOString(),
      isAnonymous: isAnonymous,
      timestampDate: likeData.timestamp?.toDate?.() || new Date()
    };
  });
  
  // Ordenar likes por timestamp descendente (más recientes primero)
  likesData = rawLikes.sort((a, b) => {
    return b.timestampDate.getTime() - a.timestampDate.getTime();
  }).map(like => {
    // Remover timestampDate del resultado final
    const { timestampDate, ...finalLike } = like;
    return finalLike as LikeData;
  });

  // Calcular estadísticas
  likesStats = {
    totalLikes: likesData.length,
    totalUsers: uniqueUsers.size,
    totalArticles: uniqueArticles.size,
    topArticles: Array.from(articleCounts.entries())
      .map(([id, count]) => ({
        id,
        title: `Post: ${id}`, // Como no hay posts principales, usar el ID
        count
      }))
      .sort((a, b) => b.count - a.count)
      .slice(0, 5),
    topUsers: Array.from(userCounts.entries())
      .map(([id, count]) => ({
        id,
        name: usersMap.get(id)?.displayName || usersMap.get(id)?.email?.split('@')[0] || 'Usuario',
        count
      }))
      .sort((a, b) => b.count - a.count)
      .slice(0, 5)
  };

  console.log(`✅ Likes procesados: ${likesData.length}`);
  console.log(`📊 Estadísticas: ${likesStats.totalUsers} usuarios únicos, ${likesStats.totalArticles} artículos únicos`);

} catch (err: unknown) {
  console.error("❌ Error obteniendo likes desde Firebase:", err);
  error = (err as Error).message || "Ocurrió un error al cargar los likes.";
}
---

<DashboardLayout title="Gestión de Likes - Panel de Administración">
  <div class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Gestión de Likes</h1>
      <p class="text-gray-600">Visualiza y analiza todas las interacciones de "me gusta" del sitio. Obtén insights sobre el contenido más popular.</p>
      
      {error && (
        <div class="mt-4 bg-red-100 border-l-4 border-red-500 text-red-700 p-4" role="alert">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm">
                <strong>Error:</strong> {error}
              </p>
            </div>
          </div>
        </div>
      )}
      
      {!error && likesData.length > 0 && (
        <div class="mt-4 bg-blue-50 border-l-4 border-blue-400 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-blue-700">
                <strong>Likes cargados:</strong> {likesData.length} like{likesData.length !== 1 ? 's' : ''} encontrado{likesData.length !== 1 ? 's' : ''}
              </p>
              <p class="text-sm text-blue-600 mt-1">
                <strong>Resumen:</strong> {likesStats.totalUsers} usuarios únicos, {likesStats.totalArticles} artículos únicos, 
                {likesData.filter(l => l.isAnonymous).length} likes anónimos
              </p>
            </div>
          </div>
        </div>
      )}
    </div>

    {!error && (
      <LikesManager likes={likesData} stats={likesStats} client:load />
    )}
  </div>
</DashboardLayout>
