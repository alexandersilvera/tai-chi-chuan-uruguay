---
// Asegura que esta página se renderice en el servidor
export const prerender = false;

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import ArticleManagerWithProvider from '@/components/dashboard/ArticleManagerWithProvider.jsx';

---

<DashboardLayout title="Gestión de Artículos - Panel de Administración">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-4 text-green-600">Gestión de Artículos</h1>
    <p class="mb-6">Aquí podrás crear, editar y eliminar artículos del blog.</p>

    {/* Usar el componente React con una directiva client:* */}
    <ArticleManagerWithProvider client:load />
  </div>
</DashboardLayout>
