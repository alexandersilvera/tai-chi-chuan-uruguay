rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Colección: posts ---
    match /posts/{postId} {
      // Cualquiera puede leer el contenido del post
      allow read: if true;
      // Solo los admins pueden escribir directamente en el post (ej. editar contenido)
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

      // --- Subcolección: likes (dentro de posts) ---
      match /likes/{userIdOrLocalId} {
        // Cualquiera puede verificar si un usuario/visitante específico ha dado like
        allow read: if true;

        // Permitir crear un like solo si:
        // 1. Es un usuario autenticado y el ID coincide
        // 2. El documento contiene campos válidos
        // 3. El timestamp es reciente (dentro de los últimos 5 segundos)
        allow create: if request.auth != null
                      && request.auth.uid == userIdOrLocalId
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.timestamp is timestamp
                      && request.resource.data.timestamp > request.time - duration.value(5, 's');

        // Permitir eliminar un like solo si el usuario es el dueño
        allow delete: if request.auth != null
                      && request.auth.uid == userIdOrLocalId;

        // No permitir actualizaciones directas
        allow update: if false;
      }

      // --- Subcolección: comments (dentro de posts) ---
      match /comments/{commentId} {
        // Cualquiera puede leer comentarios (documentos individuales y la lista)
        allow read, list: if true;

        // Solo usuarios autenticados pueden crear comentarios, con validaciones
        allow create: if request.auth != null
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.timestamp is timestamp; // Permite serverTimestamp() del cliente

        // No permitir actualizaciones ni eliminaciones de comentarios
        allow update, delete: if false;
      }
    }

    // --- Colección: users ---
    match /users/{userId} {
      // El usuario autenticado puede leer y escribir su propio documento
      // Un administrador también puede leer o escribir cualquier documento de usuario
      allow read, write: if (request.auth != null && request.auth.uid == userId)
                         || (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);

      // --- Subcolección: likes (dentro de users) ---
      match /likes/{postId} {
         // El usuario puede leer su propia lista de likes
         allow read: if request.auth != null && request.auth.uid == userId;

         // Permitir crear un registro de like solo con campos válidos
         allow create: if request.auth != null
                       && request.auth.uid == userId
                       && request.resource.data.keys().hasOnly(['timestamp', 'postSlug'])
                       && request.resource.data.postSlug == postId
                       && request.resource.data.timestamp is timestamp
                       && request.resource.data.timestamp > request.time - duration.value(5, 's');

         // Permitir eliminar su propio like
         allow delete: if request.auth != null && request.auth.uid == userId;

         // No permitir actualizaciones
         allow update: if false;
      }
    }

    // --- Colección: likes (contador global) ---
    match /likes/{slug} {
      allow read: if true;

      // Cloud Functions pueden escribir libremente (no tienen auth)
      // Las Cloud Functions se ejecutan con credenciales de admin
      allow write: if true;

      // Nota: La seguridad está garantizada por las Cloud Functions
      // que validan autenticación, rate limiting, etc.
    }

    // --- Colección: likesLog ---
    match /likesLog/{docId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow write: if true; // Cloud Functions pueden escribir libremente
    }

    // --- Colección: abuseReports ---
    match /abuseReports/{reportId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow write: if true; // Cloud Functions pueden escribir libremente
    }

    // --- Colección: articles ---
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

      // Subcolección de comentarios
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.timestamp == request.time;
        allow update, delete: if false;
      }
    }
  }
}
