rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Colección: posts ---
    match /posts/{postId} {
      // Cualquiera puede leer el contenido del post
      allow read: if true;
      // Solo los admins pueden escribir directamente en el post (ej. editar contenido)
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

      // --- Subcolección: likes (dentro de posts) ---
      match /likes/{userIdOrLocalId} {
        // Cualquiera puede verificar si un usuario/visitante específico ha dado like
        allow read: if true;

        // Permitir crear un like si:
        // 1. Es un usuario autenticado y el ID coincide
        // 2. Es anónimo (auth es null) y el ID del documento coincide con el userId en los datos (que será el localId)
        allow create: if request.auth != null && request.auth.uid == userIdOrLocalId;

        // Permitir eliminar un like si:
        // 1. Es un usuario autenticado y el ID coincide
        // 2. Es anónimo (auth es null) y el ID del documento coincide con el userId en los datos (que será el localId)
        allow delete: if request.auth != null && request.auth.uid == userIdOrLocalId;

        // No permitir actualizaciones directas
        allow update: if false;
      }

      // --- Subcolección: comments (dentro de posts) ---
      match /comments/{commentId} {
        // Cualquiera puede leer comentarios (documentos individuales y la lista)
        allow read, list: if true;

        // Solo usuarios autenticados pueden crear comentarios, con validaciones
        allow create: if request.auth != null
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.timestamp is timestamp; // Permite serverTimestamp() del cliente

        // No permitir actualizaciones ni eliminaciones de comentarios
        allow update, delete: if false;
      }
    }

    // --- Colección: users ---
    match /users/{userId} {
      // El usuario autenticado puede leer y escribir su propio documento
      // Un administrador también puede leer o escribir cualquier documento de usuario
      allow read, write: if (request.auth != null && request.auth.uid == userId)
                         || (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);

      // --- Subcolección: likes (dentro de users) ---
      match /likes/{postId} {
         // El usuario autenticado puede gestionar su propia lista de likes
         allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
